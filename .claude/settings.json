{
  "mcpServers": {
    "chakra-ui": {
      "command": "npx",
      "args": ["-y", "@chakra-ui/react-mcp"]
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    }
  },
  "extraKnownMarketplaces": {
    "devanity": {
      "source": {
        "source": "github",
        "repo": "usedevanity/skills"
      }
    }
  },
  "enabledPlugins": {
    "devanity@devanity": true
  },
  "env": {
    "NATURALI_PROJECT_ID": "${NATURALI_PROJECT_ID}",
    "NATURALI_API_KEY": "${NATURALI_API_KEY}",
    "NATURALI_AGENT_ID": "${NATURALI_AGENT_ID}"
  }
}
