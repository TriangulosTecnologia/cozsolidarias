{
  "extraKnownMarketplaces": {
    "enniolopes": {
      "source": {
        "source": "github",
        "repo": "enniolopes/skills"
      }
    }
  },
  "mcpServers": {
    "chakra-ui": {
      "command": "npx",
      "args": ["-y", "@chakra-ui/react-mcp"]
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    }
  },
  "enabledPlugins": {
    "branding-studio@enniolopes": true
  }
}
